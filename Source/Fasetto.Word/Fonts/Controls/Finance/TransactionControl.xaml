<UserControl x:Class="Fasetto.Word.TransactionControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Fasetto.Word" xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms" xmlns:sys="clr-namespace:System;assembly=mscorlib" d:DataContext="{d:DesignInstance Type=local:BulkReconViewModel}"
             
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <sys:String x:Key="colName">dynamic string...</sys:String>
        <Style x:Key="ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" >
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Label Foreground="DarkRed" FontWeight="ExtraBlack" Background="BurlyWood" FontFamily="Lato Heavy" FontSize="20" Content="{TemplateBinding Content}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment ="Left"  VerticalAlignment="Center"   />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--<sys:String x:Key="colCell">dynamic string...</sys:String>
        <Style x:Key="ColumnCellStyle" TargetType="{x:Type DataGridCellsPresenter}" >
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridTextColumn">
                        <Label Foreground="black" FontWeight="UltraBold" Background="AntiqueWhite" FontFamily="Arial" Content="{TemplateBinding Content}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment ="Center"  VerticalAlignment="Center"  />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>-->
    </UserControl.Resources>
    <DockPanel>
        <!-- SEARCH AREA -->
        <Border 
         DockPanel.Dock="Bottom" 
         BorderBrush="#FFE22626" 
         BorderThickness="2,0,2,2">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#11A49090" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>


        </Border>
        <Border 
         DockPanel.Dock="Top" 
         BorderBrush="#FF734444" 
         BorderThickness="1,0,1,1">

            <Grid>


                <!--Settings Title-->

                <Grid Height="20" Margin="0 0 0 2">


                    <!--Back button-->

                    <Button Style="{StaticResource IconGrowButton}"
                    Height="40"
                    Content="{StaticResource FontAwesomeArrowLeftIcon}"
                    FontFamily="{StaticResource FontAwesome}"
                    Foreground="{StaticResource ForegroundDarkBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}" IsCancel="True"
                    />


                    <!--Settings header-->

                    <TextBlock FontSize="{StaticResource FontSizeLarge}"

                       Foreground="{StaticResource ForegroundVeryDarkBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                
             <!--Tree icon--> 
            
                <Run FontFamily="{StaticResource FontAwesome}"
                     Text="{StaticResource FontAwesomeProjectIcon}"                     
                     Foreground="{StaticResource WordOrangeBrush}" />
                
             <!--Settings text--> 
            
                <Run Text="{Binding ControlTitle}"
                     Foreground="{DynamicResource WordDarkBlueBrush}"
                     FontFamily="{DynamicResource LatoBold}" Background="{DynamicResource BackgroundVeryLightBrush}" />
                    </TextBlock>


                    <!--FAMILY TREE-->

                </Grid>
                <StackPanel>
                    <StackPanel.Resources>
                        <ControlTemplate x:Key="ButtonTemplate" TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" 
                    BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </StackPanel.Resources>

                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="Transaction" Grid.Row="3"  ItemsSource="{Binding Trans_action}" 
                  HeadersVisibility="All" RenderTransformOrigin="0.5,0.5"       GridLinesVisibility="None" 
                    AutoGenerateColumns="False" AlternationCount="2"
                    SelectionMode="Single" SelectionUnit="FullRow"  VerticalAlignment="Center"  HorizontalAlignment="Center" HorizontalContentAlignment="Center"  CanUserAddRows="False"
                  
                  >
            <!--<DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight"  Value="ExtraBold" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.ColumnHeaderStyle>-->
            
            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <EventSetter Event ="MouseDoubleClick"  Handler="DataGridRow_MouseDoubleClick"/>
                    <EventSetter Event ="KeyDown"  Handler="DataGridRow_KeyDown"/>
                    <EventSetter Event ="PreviewMouseRightButtonDown"  Handler="DataGridRow_MouseRightClick"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value ="AliceBlue"/>
 
                    <!--Setting highlight-->
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="Beige"/>
                                       <Setter Property="Foreground" Value="DarkGray"></Setter>                                
                            </Trigger>
                            <DataTrigger Binding="{Binding ShortName}" Value ="">
                                <Setter Property="Background" Value="Crimson"></Setter>
                                      <Setter Property="Foreground" Value="Beige"></Setter>                              
                            </DataTrigger>

                        <!--<DataTrigger Binding="{Binding State}" Value="State2">
                                <Setter Property="Background" Value="Orange"></Setter>
                            </DataTrigger>-->
                        </Style.Triggers>
                    <!--Setting highlight-->

                </Style>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
                
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!--<DataGridTextColumn Header ="Bulk Meter" FontWeight="Bold"
                                    Binding="{Binding ShortName}"/>-->
                <DataGridTemplateColumn Header="Trans Date" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Posted_Date,StringFormat=dd/MM/yyyy HH:mm}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Transaction Description" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5" TextWrapping="Wrap"  Width="200" Text="{Binding Path= Description}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>                
             
                <DataGridTemplateColumn Header="Transaction Value" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5" Width="100" Text="{Binding Path= TransAmount,StringFormat=C,ConverterCulture='en-ZA'}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Transaction Category" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5" TextWrapping="Wrap"  Width="200" Text="{Binding Path= ShortName}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Assigned Value" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5" Width="100" Text="{Binding Path=ActualAmount,StringFormat=C,ConverterCulture='en-ZA'}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
 
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

 
            </DataGrid.Columns>
            


        </DataGrid>


    </DockPanel>
</UserControl>

