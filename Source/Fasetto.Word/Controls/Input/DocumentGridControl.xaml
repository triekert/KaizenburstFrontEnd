<UserControl x:Class="Fasetto.Word.DocumentGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fasetto.Word" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600"
             x:Name="DocumentGridRoot">

    <UserControl.Resources>
        <Style x:Key="ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Label Foreground="{StaticResource ForegroundVeryDarkBrush}" FontWeight="UltraBold" Background="{StaticResource WordLightBlueBrush}" FontFamily="Lato Heavy" FontSize="20" Content="{TemplateBinding Content}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DataGrid x:Name="Transaction" ItemsSource="{Binding DocumentList, ElementName=DocumentGridRoot}" 
              HeadersVisibility="All" RenderTransformOrigin="0.5,0.5" GridLinesVisibility="None" 
              AutoGenerateColumns="False" AlternationCount="2"
              SelectionMode="Single" SelectionUnit="Cell" VerticalAlignment="Center" HorizontalAlignment="Stretch" CanUserAddRows="False"
              CanUserSortColumns="True" CanUserResizeColumns="True" CanUserResizeRows="True" AllowDrop="True">

        <DataGrid.ColumnHeaderStyle>
            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="FontWeight" Value="ExtraBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </DataGrid.ColumnHeaderStyle>

        <DataGrid.Resources>
            <Style TargetType="DataGridRow">
                <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                <EventSetter Event="PreviewKeyDown" Handler="DataGridRow_KeyDown"/>
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_MouseRightClick"/>
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="AliceBlue"/>

                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource WordOrangeBrush}"/>
                        <Setter Property="Foreground" Value="DarkGray"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding ShortName}" Value="">
                        <Setter Property="Background" Value="Crimson"/>
                        <Setter Property="Foreground" Value="Beige"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KPartyName}" Value="">
                        <Setter Property="Background" Value="Crimson"/>
                        <Setter Property="Foreground" Value="Beige"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRemove}" Value="true">
                        <Setter Property="Background" Value="{StaticResource WordOrangeBrush}"/>
                        <Setter Property="Foreground" Value="DarkCyan"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </DataGrid.Resources>

        <DataGrid.Columns>
            <DataGridTemplateColumn Header="Document Description" HeaderStyle="{StaticResource ColumnHeaderStyle}" SortDirection="Descending">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Margin="5" TextWrapping="Wrap" Width="200" Text="{Binding Path=DocDescription}" FontSize="12" FontWeight="Normal" FontFamily="Lato Heavy" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                        <TextBox Margin="5" Width="200" 
                                 Text="{Binding Path=DocDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"
                                 Loaded="TextBox_Loaded"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Linked Document" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Image Source="{Binding DocImage}" MaxWidth="100" MaxHeight="130"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Linked Party" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Margin="5" TextWrapping="Wrap" Width="200" Text="{Binding Path=KPartyName}" FontSize="12" FontWeight="Normal" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Assigned Value" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Margin="5" Width="100" Text="{Binding Path=ActualAmount, StringFormat=C, ConverterCulture='en-ZA'}" FontSize="12" FontWeight="Normal" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>