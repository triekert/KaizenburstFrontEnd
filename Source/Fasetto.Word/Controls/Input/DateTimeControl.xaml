<UserControl x:Class="Fasetto.Word.DateTimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fasetto.Word"
             xmlns:core="clr-namespace:Fasetto.Word.Core;assembly=Fasetto.Word.Core"
             mc:Ignorable="d" 
             d:DataContext="{x:Static local:TextEntryDesignModel.Instance}">
    
    <!-- Grey underline -->
    <Border BorderBrush="{StaticResource ForegroundVeryDarkBrush}"
            IsEnabled="{Binding Working, Converter={local:BooleanInvertConverter}}"
                Margin="5 5 10 5"            
            
            BorderThickness="2">

        <Grid Background="{StaticResource ForegroundLightBrush}" Height="80">

            <!-- Double click to edit -->
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
            </Grid.InputBindings>
            
            <!-- Hover over to show edit button -->
            <Grid.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="1" 
                                             Duration="0:0:0.4" 
                                             Storyboard.TargetName="EditButton"
                                             Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="0" 
                                             Duration="0:0:0.4" 
                                             Storyboard.TargetName="EditButton"
                                             Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="25" />-->
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <!-- Label -> Name* -> Buttons -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="LabelColumnDefinition" Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="230" />                
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            

            <!-- Label -->
            <TextBlock Text="{Binding Label}"
                Grid.Column="0"       
                Grid.RowSpan="2"
                Name="Heading"
                Margin="0 0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource LatoRegular}"
             />

            <!-- Label -->
            <TextBlock Text="Date"  
                    Grid.Row="0"
                    Grid.Column="1"
                Name="Label"
                Margin="15 12"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource LatoRegular}"
                FontWeight="ExtraBold"
                IsEnabled="{Binding Editing}"
                Visibility="{Binding Editing, ConverterParameter=True, Converter={local:BooleanToVisiblityConverter}}"                       
                       
                      
                />
            <!-- Edit Date -->

            <DatePicker x:Name="DP"  SelectedDate="{Binding EditedDateTime, Mode= Twoway, UpdateSourceTrigger=PropertyChanged}" Padding="10 " 
                                SelectedDateFormat="Short" HorizontalAlignment="Center" Grid.Row="0"  Grid.Column="2" Width="200"
                        IsEnabled="{Binding Editing}"
                local:AnimateFadeInProperty.Value="{Binding Editing}"
                local:FocusAndSelectProperty.Value="{Binding Editing}"                            
            />



            <TextBlock Text ="{Binding EditedDateTime,StringFormat=yyyy/MM/dd HH:mm}" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.RowSpan="2"  Grid.Column="3" Padding="20 10 20 10" FontFamily="{StaticResource LatoRegular}"   FontWeight="ExtraBold" FontSize="16"/> 
            <!-- Content -->

            <!--<StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Vertical">-->
                <TextBlock Text="Time"  
                    Grid.Row="1"
                    Grid.Column="1"
                Margin="15 12"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource LatoRegular}"   
                FontWeight="ExtraBlack"
                IsEnabled="{Binding Editing}"      
                Visibility="{Binding Editing, ConverterParameter=True, Converter={local:BooleanToVisiblityConverter}}"                             
                />
                <ComboBox x:Name="TP" 
                        Height="20"
                        VerticalAlignment="Center"
                        MaxDropDownHeight="300"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Grid.Row="1"
                        Grid.Column="2"                         
                        IsEnabled="{Binding Editing}"
                        Width="200"
                        IsEditable="True"
                        local:AnimateFadeInProperty.Value="{Binding Editing}"
                        local:FocusAndSelectProperty.Value="{Binding Editing}"                                       
                        SelectedItem="{Binding EditedTime, Mode=TwoWay}"
                        SelectionChanged="TP_SelectionChanged"   
                        Margin="15 12"                          
                          >
                    
                        <ComboBoxItem>00:00</ComboBoxItem>
                        <ComboBoxItem>00:30</ComboBoxItem>
                        <ComboBoxItem>01:00</ComboBoxItem>
                        <ComboBoxItem>01:30</ComboBoxItem>
                        <ComboBoxItem>02:00</ComboBoxItem>
                        <ComboBoxItem>02:30</ComboBoxItem>
                        <ComboBoxItem>03:00</ComboBoxItem>
                        <ComboBoxItem>03:30</ComboBoxItem>
                        <ComboBoxItem>04:00</ComboBoxItem>
                        <ComboBoxItem>04:30</ComboBoxItem>
                        <ComboBoxItem>05:00</ComboBoxItem>
                        <ComboBoxItem>05:30</ComboBoxItem>
                        <ComboBoxItem>06:00</ComboBoxItem>
                        <ComboBoxItem>06:30</ComboBoxItem>
                        <ComboBoxItem>07:00</ComboBoxItem>
                        <ComboBoxItem>07:30</ComboBoxItem>
                        <ComboBoxItem>08:00</ComboBoxItem>
                        <ComboBoxItem>08:30</ComboBoxItem>
                        <ComboBoxItem>09:00</ComboBoxItem>
                        <ComboBoxItem>09:30</ComboBoxItem>
                        <ComboBoxItem>10:00</ComboBoxItem>
                        <ComboBoxItem>10:30</ComboBoxItem>
                        <ComboBoxItem>11:00</ComboBoxItem>
                        <ComboBoxItem>11:30</ComboBoxItem>
                        <ComboBoxItem>12:00</ComboBoxItem>
                        <ComboBoxItem>12:30</ComboBoxItem>
                        <ComboBoxItem>13:00</ComboBoxItem>
                        <ComboBoxItem>13:30</ComboBoxItem>
                        <ComboBoxItem>14:00</ComboBoxItem>
                        <ComboBoxItem>14:30</ComboBoxItem>
                        <ComboBoxItem>15:00</ComboBoxItem>
                        <ComboBoxItem>15:30</ComboBoxItem>
                        <ComboBoxItem>16:00</ComboBoxItem>
                        <ComboBoxItem>16:30</ComboBoxItem>
                        <ComboBoxItem>17:00</ComboBoxItem>
                        <ComboBoxItem>17:30</ComboBoxItem>
                        <ComboBoxItem>18:00</ComboBoxItem>
                        <ComboBoxItem>18:30</ComboBoxItem>
                        <ComboBoxItem>19:00</ComboBoxItem>
                        <ComboBoxItem>19:30</ComboBoxItem>
                        <ComboBoxItem>20:00</ComboBoxItem>
                        <ComboBoxItem>20:30</ComboBoxItem>
                        <ComboBoxItem>21:00</ComboBoxItem>
                        <ComboBoxItem>21:30</ComboBoxItem>
                        <ComboBoxItem>22:00</ComboBoxItem>
                        <ComboBoxItem>22:30</ComboBoxItem>
                        <ComboBoxItem>23:00</ComboBoxItem>
                        <ComboBoxItem>23:30</ComboBoxItem>
                </ComboBox>

    



            <!-- Edit button container -->
            <Grid Grid.Column="4"
                  Grid.RowSpan="2"
                  
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  local:AnimateFadeInProperty.Value="{Binding Editing, Converter={local:BooleanInvertConverter}}">
                
                <!-- Edit Button -->
                <Button Content="{StaticResource FontAwesomeEllipsisIcon}"
                        FontFamily="{StaticResource FontAwesome}"
                        x:Name="EditButton"
                        Opacity="0"
                        Padding="8 5"
                        Margin="0"
                        Cursor="Hand"
                        Command="{Binding EditCommand}"
                        Background="{StaticResource ForegroundDarkBrush}"
                        FontSize="{StaticResource FontSizeSmall}"
                        VerticalAlignment="Center"
                        />
            </Grid>

            <!-- Working spinner container -->
            <Grid Grid.Column="4" 
                  Grid.Row="1"                  
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  local:AnimateFadeInProperty.Value="{Binding Working}">

                <Border Padding="0 0 5 0">
                    <TextBlock Style="{StaticResource SpinningText}" />
                </Border>
                

            </Grid>

            <StackPanel Grid.Column="4"
                  Grid.Row="1"                        
                        Orientation="Horizontal"
                        >

                <!-- Save Button -->
                <Button Content="{StaticResource FontAwesomeTickIcon}"
                        FontFamily="{StaticResource FontAwesome}"
                        local:AnimateFadeInProperty.Value="{Binding Editing}"
                        IsDefault="True"
                        Cursor="Hand"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource WordGreenBrush}"
                        Padding="8 5"
                        Margin="0 0 5 0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSmall}"

                        />
                        <!--IsEnabled="{Binding ElementName=TP,Path =SelectedItem}"--> 
                <!-- Cancel Button -->
                <Button Content="{StaticResource FontAwesomeCloseIcon}"
                        FontFamily="{StaticResource FontAwesome}"
                        local:AnimateFadeInProperty.Value="{Binding Editing}"
                        IsCancel="True"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}"
                        Background="{StaticResource WordOrangeBrush}"
                        Padding="8 5"
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSmall}"
                        />
            </StackPanel>

        </Grid>
            
    </Border>
</UserControl>
