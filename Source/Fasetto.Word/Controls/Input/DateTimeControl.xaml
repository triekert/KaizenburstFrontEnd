<UserControl x:Class="Fasetto.Word.DateTimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fasetto.Word"
             xmlns:core="clr-namespace:Fasetto.Word.Core;assembly=Fasetto.Word.Core"
             mc:Ignorable="d" 
             d:DataContext="{x:Static local:TextEntryDesignModel.Instance}">
            <UserControl.Resources>
                <local:TimeToClosestComboBoxItemConverter x:Key="TimeToClosestConverter" />
            </UserControl.Resources>
    <!-- Grey underline -->
    <Border BorderBrush="{StaticResource ForegroundVeryDarkBrush}"
            IsEnabled="{Binding Working, Converter={local:BooleanInvertConverter}}"
                Margin="5 5 10 5"            
            
            BorderThickness="2">

        <Grid Background="{StaticResource ForegroundLightBrush}" Height="80">

            <!-- Double click to edit -->
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                <KeyBinding Command="{Binding SaveCommand}" Key="Return"/>
            </Grid.InputBindings>
            
            <!-- Hover over to show edit button -->
            <Grid.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="1" 
                                             Duration="0:0:0.4" 
                                             Storyboard.TargetName="EditButton"
                                             Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="0" 
                                             Duration="0:0:0.4" 
                                             Storyboard.TargetName="EditButton"
                                             Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="25" />-->
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Label -> Name* -> Buttons -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="LabelColumnDefinition" Width="130" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />                
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            

            <!-- Label -->
            <TextBlock Text="{Binding Label}"
                Grid.Column="0"       
                Grid.RowSpan="2"
                Name="Heading"
                Margin="5 5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource LatoRegular}"
             />

            <!-- Label -->
            <TextBlock Text="Date"  
                    Grid.Row="0"
                    Grid.Column="1"
                Name="Label"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource LatoRegular}"
                FontWeight="ExtraBold"
                IsEnabled="{Binding Editing}"
                Visibility="{Binding Editing, ConverterParameter=True, Converter={local:BooleanToVisiblityConverter}}"                       
                       
                      
                />
            <!-- Edit Date -->

            <DatePicker x:Name="DP"  SelectedDate="{Binding EditedDateTime, Mode= Twoway, UpdateSourceTrigger=PropertyChanged}" Padding="5 " 
                                SelectedDateFormat="Short" HorizontalAlignment="Center" Grid.Row="0"  Grid.Column="2" Width="200"
                        IsEnabled="{Binding Editing}"
                local:AnimateFadeInProperty.Value="{Binding Editing}"
                local:FocusAndSelectProperty.Value="{Binding Editing}"                            
            />



            <TextBlock Text ="{Binding EditedDateTime,StringFormat=yyyy/MM/dd HH:mm}" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.RowSpan="2"  Grid.Column="3" Padding="20 10 20 10" FontFamily="{StaticResource LatoRegular}"   FontWeight="ExtraBold" FontSize="16"/> 
            <!-- Content -->

            <!--<StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Vertical">-->
                <TextBlock Text="Time"  
                    Grid.Row="1"
                    Grid.Column="1"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource LatoRegular}"   
                FontWeight="ExtraBlack"
                IsEnabled="{Binding Editing}"      
                Visibility="{Binding Editing, ConverterParameter=True, Converter={local:BooleanToVisiblityConverter}}"                             
                />
            <StackPanel                  
                Grid.Column="2"       
                Grid.Row="2"
                Orientation="Vertical">
                          
                <!-- Time Text Box (Escaped string format to avoid XAML parser error) -->
            <!--<TextBox Text="{Binding EditedDateTime, StringFormat='{}{0:HH:mm}', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                     Height="22"
                     VerticalAlignment="Top"
                     Width="200"
                     Margin="15 2 15 0"
                     IsEnabled="{Binding Editing}"
                     local:AnimateFadeInProperty.Value="{Binding Editing}" />-->
            <ComboBox x:Name="TP" 
          Height="20"
          VerticalAlignment="Center"
          MaxDropDownHeight="300"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          Visibility="{Binding Editing,ConverterParameter=True, Converter={local:BooleanToVisiblityConverter}}"
          IsEnabled="{Binding Editing}"
          Width="100"
          IsEditable="True"
          SelectionChanged="TP_SelectionChanged"   
          Margin="5"                          
          ItemsSource="{Binding AvailableTimes}"
          SelectedItem="{Binding EditedDateTime, Converter={StaticResource TimeToClosestConverter}, Mode=TwoWay}"       
          IsDropDownOpen="False">

                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
</StackPanel>


            <!-- Edit button container -->
            <Grid Grid.Column="4"
                  Grid.RowSpan="2"
                  
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  local:AnimateFadeInProperty.Value="{Binding Editing, Converter={local:BooleanInvertConverter}}">
                
                <!-- Edit Button -->
                <Button Content="{StaticResource FontAwesomeEllipsisIcon}"
                        FontFamily="{StaticResource FontAwesome}"
                        x:Name="EditButton"
                        Opacity="0"
                        Padding="8 5"
                        Margin="0"
                        Cursor="Hand"
                        Command="{Binding EditCommand}"
                        Background="{StaticResource ForegroundDarkBrush}"
                        FontSize="{StaticResource FontSizeSmall}"
                        VerticalAlignment="Center"
                        />
            </Grid>

            <!-- Working spinner container -->
            <Grid Grid.Column="4" 
                  Grid.Row="1"                  
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  local:AnimateFadeInProperty.Value="{Binding Working}">

                <Border Padding="0 0 5 0">
                    <TextBlock Style="{StaticResource SpinningText}" />
                </Border>
                

            </Grid>

            <StackPanel Grid.Column="4"
                  Grid.Row="1"                        
                        Orientation="Horizontal"
                        >

                <!-- Save Button -->
                <Button Content="{StaticResource FontAwesomeTickIcon}"
                        FontFamily="{StaticResource FontAwesome}"
                        local:AnimateFadeInProperty.Value="{Binding Editing}"
                        IsDefault="True"
                        Cursor="Hand"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource WordGreenBrush}"
                        Padding="8 5"
                        Margin="0 0 5 0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSmall}"

                        />
                        <!--IsEnabled="{Binding ElementName=TP,Path =SelectedItem}"--> 
                <!-- Cancel Button -->
                <Button Content="{StaticResource FontAwesomeCloseIcon}"
                        FontFamily="{StaticResource FontAwesome}"
                        local:AnimateFadeInProperty.Value="{Binding Editing}"
                        IsCancel="True"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}"
                        Background="{StaticResource WordOrangeBrush}"
                        Padding="8 5"
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSmall}"
                        />
            </StackPanel>

        </Grid>
            
    </Border>
</UserControl>
