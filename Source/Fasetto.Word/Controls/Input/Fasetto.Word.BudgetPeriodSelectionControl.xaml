<UserControl x:Class="Fasetto.Word.BudgetPeriodSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fasetto.Word"
             xmlns:core="clr-namespace:Fasetto.Word.Core;assembly=Fasetto.Word.Core"
             mc:Ignorable="d" 
             d:DataContext="{x:Static local:TextEntryDesignModel.Instance}">

    <Border BorderBrush="{StaticResource ForegroundVeryDarkBrush}"
            IsEnabled="{Binding Working, Converter={local:BooleanInvertConverter}}"
            Margin="5 5 10 5"
            BorderThickness="2">

        <Grid Background="{StaticResource ForegroundLightBrush}" Height="80">

            <!-- Input Bindings -->
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                <KeyBinding Command="{Binding SaveCommand}" Key="Return"/>
            </Grid.InputBindings>

            <!-- Hover Triggers -->
            <Grid.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="1" Duration="0:0:0.4" Storyboard.TargetName="EditButton" Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="0" Duration="0:0:0.4" Storyboard.TargetName="EditButton" Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="LabelColumnDefinition" Width="130" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Control Heading -->
            <TextBlock Text="{Binding Label}"
                       Grid.Column="0"       
                       Grid.RowSpan="2"
                       Name="Heading"
                       Margin="5 5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource LatoRegular}" />

            <!-- Upper Row Label: Budget -->
            <TextBlock Text="Budget"  
                       Grid.Row="0"
                       Grid.Column="1"
                       Margin="5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource LatoRegular}"
                       FontWeight="ExtraBold"
                       IsEnabled="{Binding Editing}"
                       Visibility="{Binding Editing, ConverterParameter=True, Converter={local:BooleanToVisiblityConverter}}" />

            <!-- Upper ComboBox: Budget selection -->
            <ComboBox x:Name="BudgetComboBox"
                      Grid.Row="0" 
                      Grid.Column="2" 
                      Width="200"
                      Height="22"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      MaxDropDownHeight="300"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ItemsSource="{Binding BudgetPeriodList}"
                      SelectedItem="{Binding MSelectedBudget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsDropDownOpen="False"
                      IsEnabled="{Binding Editing}"
                      local:AnimateFadeInProperty.Value="{Binding Editing}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=Name}" FontSize="12" FontWeight="Normal" FontFamily="Arial" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Readonly Display for Budget Name -->
            <TextBlock Text="{Binding MSelectedBudget.Name, StringFormat='Budget: {0}'}" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Right" 
                       Grid.RowSpan="2"  
                       Grid.Column="3" 
                       Padding="20 10 20 10" 
                       FontFamily="{StaticResource LatoRegular}"   
                       FontWeight="ExtraBold" 
                       FontSize="16" />

            <!-- Lower Row Label: Month -->
            <TextBlock Text="Month"  
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource LatoRegular}"   
                       FontWeight="ExtraBlack"
                       IsEnabled="{Binding Editing}"      
                       Visibility="{Binding Editing, ConverterParameter=True, Converter={local:BooleanToVisiblityConverter}}" />

            <!-- Lower ComboBox: Budget Month selection -->
            <StackPanel Grid.Column="2"       
                        Grid.Row="2"
                        Orientation="Vertical">
                <ComboBox x:Name="BudgetMonthComboBox"  
                          Height="20"
                          VerticalAlignment="Center"
                          MaxDropDownHeight="300"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Editing, ConverterParameter=True, Converter={local:BooleanToVisiblityConverter}}"
                          IsEnabled="{Binding Editing}"
                          Width="200"
                          ItemsSource="{Binding BudgetMonthList}"
                          SelectedItem="{Binding MSelectedBudgetMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="5"
                          IsDropDownOpen="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=BudgetMonth}" FontSize="12" FontWeight="Normal" FontFamily="Arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Edit Button Container -->
            <Grid Grid.Column="4"
                  Grid.RowSpan="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  local:AnimateFadeInProperty.Value="{Binding Editing, Converter={local:BooleanInvertConverter}}">

                <Button Content="{StaticResource FontAwesomeEllipsisIcon}"
                        FontFamily="{StaticResource FontAwesome}"
                        x:Name="EditButton"
                        Opacity="0"
                        Padding="8 5"
                        Margin="0"
                        Cursor="Hand"
                        Command="{Binding EditCommand}"
                        Background="{StaticResource ForegroundDarkBrush}"
                        FontSize="{StaticResource FontSizeSmall}"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Working Spinner -->
            <Grid Grid.Column="4" 
                  Grid.Row="1"                 
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  local:AnimateFadeInProperty.Value="{Binding Working}">
                <Border Padding="0 0 5 0">
                    <TextBlock Style="{StaticResource SpinningText}" />
                </Border>
            </Grid>

            <!-- Save and Cancel Panel -->
            <StackPanel Grid.Column="4"
                        Grid.Row="1"                     
                        Orientation="Horizontal">
                <Button Content="{StaticResource FontAwesomeTickIcon}"
                        FontFamily="{StaticResource FontAwesome}"
                        local:AnimateFadeInProperty.Value="{Binding Editing}"
                        IsDefault="True"
                        Cursor="Hand"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource WordGreenBrush}"
                        Padding="8 5"
                        Margin="0 0 5 0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSmall}" />

                <Button Content="{StaticResource FontAwesomeCloseIcon}"
                        FontFamily="{StaticResource FontAwesome}"
                        local:AnimateFadeInProperty.Value="{Binding Editing}"
                        IsCancel="True"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}"
                        Background="{StaticResource WordOrangeBrush}"
                        Padding="8 5"
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSmall}" />
            </StackPanel>

        </Grid>
    </Border>
</UserControl>