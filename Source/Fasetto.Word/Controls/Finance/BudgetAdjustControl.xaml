<UserControl x:Class="Fasetto.Word.BudgetAdjustControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fasetto.Word"
             xmlns:core="clr-namespace:Fasetto.Word.Core;assembly=Fasetto.Word.Core"
             d:DataContext="{x:Static local:HierarchyElementDesignModel.Instance}"
             mc:Ignorable="d" >

    <Border Background="{DynamicResource BackgroundLightBrush}" 
            Padding="15">



        <Grid                      Keyboard.PreviewKeyDown="TreeView_KeyBoard" ForceCursor="True">


            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Settings Title -->
            <Grid Height="30" Margin="0 0 0 20">

                <!-- Back button -->
                <Button  

                    Style="{StaticResource IconGrowButton}"
                    Height="50"
                    Content="{StaticResource FontAwesomeArrowLeftIcon}"
                    FontFamily="{StaticResource FontAwesome}"
                    Foreground="{StaticResource  WordOrangeBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}" IsCancel="True" IsDefault="True"/>
                <!--Keyboard.KeyDown="TreeView_KeyBoard"-->

                <!-- Settings header -->
                <TextBlock FontSize="{StaticResource FontSizeLarge}"
                       Foreground="{StaticResource ForegroundVeryDarkBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <!-- Cog icon -->
                <Run FontFamily="{StaticResource FontAwesome}"
                     Text="{StaticResource FontAwesomeCogIcon}"
                     Foreground="{StaticResource WordOrangeBrush}" />
                <!-- Settings text -->
                <Run Text="{Binding HeadingText}" 
                     FontFamily="{StaticResource LatoRegular}" 
                     FontWeight="Bold"
                     />
                </TextBlock>

            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1"
                  Width="800"
                  VerticalAlignment="Top"
                  >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- Profile Picture -->
                <Grid Margin="0 0 30 0"
                      VerticalAlignment="Top"
                      Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">

                    <!-- Mask for rounded corners-->
                    <Border CornerRadius="8"
                            Name="Mask"
                            Background="White"
                            />

                    <!-- Image -->
                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=Mask}" />
                        </Grid.OpacityMask>

                        <Image Source="/Images/Samples/rusty.jpg" Stretch="UniformToFill" />
                    </Grid>

                </Grid>

                <!-- Profile details -->
                <StackPanel Grid.Column="1"
                            local:TextEntryWidthMatcherProperty.Value="True">
                    <StackPanel Grid.Column="1"
                            local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Original Budget for selected Node : " FontFamily="{StaticResource LatoBold}" 
                                               Padding="10 10 10 10" FontWeight="Bold" Foreground="{StaticResource ForegroundVeryDarkBrush}"/>
                        <TextBlock  Text ="{Binding BudgetAmountStr}" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>

                                    
                        <local:TextEntryControl DataContext="{Binding BudgetAncestor}" FontWeight="ExtraBlack"  />


                    </StackPanel>
                    <StackPanel Grid.Column="1"
                            local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Original Budget for selected Node with descendants : " FontFamily="{StaticResource LatoBold}" 
                                               Padding="10 10 10 10" FontWeight="Bold" Foreground="{StaticResource ForegroundVeryDarkBrush}"/>
                        <TextBlock  Text ="{Binding BudgetAmountTotalStr}" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>

                        <local:TextEntryControl DataContext="{Binding BudgetAncestorHierarchy}" FontWeight="ExtraBlack"  />
                    </StackPanel>

                    <CheckBox Content="Only for this month" FontFamily="{StaticResource LatoBold}"  Padding="10 10 10 10" FontWeight="Bold" Foreground="{StaticResource WordRedBrush}" IsChecked="{Binding IsMonthOnly}" />
                        

                    <StackPanel Visibility="{Binding IsMenuItem, ConverterParameter=True, Converter={local:BooleanToVisiblityConverter}}"
                                >



                    </StackPanel>


                    <!--<StackPanel Orientation="Horizontal" Grid.Column="1" 
                                local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Date of Adjustment " FontFamily="{StaticResource LatoRegular}" 
                                       Padding="10 10 10 10" FontWeight="Bold"/>
                        <DatePicker x:Name="dateAdjustment"  SelectedDate="{Binding DateAdjustment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="20 10 20 10"
                                        SelectedDateFormat="Short" DisplayDateEnd = "{Binding DateEnd}"   DisplayDateStart = "{Binding DateStart}"/>


                    </StackPanel>-->



                    <StackPanel    Grid.Column="0"
                        Orientation="Horizontal">
                        
                        

                        <Button Content="{Binding AdjustmentButtonText}"
                            Command="{Binding BudgetAdjustmentCommand}"
                            FontSize="{StaticResource FontSizeRegular}"
                            />


                    </StackPanel>
                </StackPanel>


            </Grid>


        </Grid>
    </Border>
</UserControl>
