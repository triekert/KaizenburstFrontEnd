                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="VirtualizingStackPanel.IsVirtualizing" Value="true">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>-->


    </UserControl.Resources>


    <DockPanel>
        <!-- SEARCH AREA -->
        <Border 
     DockPanel.Dock="Bottom" 
     BorderBrush="#FFE22626" 
     BorderThickness="2,0,2,2">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#11A49090" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel 
            HorizontalAlignment="Stretch" 
            Margin="0,0,10,0" 
            Orientation="Horizontal"
            >
                <TextBox 
                  x:Name="searchTextBox"
                  KeyDown="SearchTextBox_KeyDown"
                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                  Width ="400" FontSize="18" TextWrapping="Wrap" RenderTransformOrigin="0.1,0.616" AutomationProperties.HelpText="Begin entering name...."
                >
                    <TextBox.InputBindings>
                        <!--Clear text on Esc-->
                        <KeyBinding Command="{Binding ClearSearchCommand}" Key="Esc" />
                        <!--Search on enter-->
                        <KeyBinding Command="{Binding SearchCommand}" Key="Return" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Style="{StaticResource IconGrowButton}" 
                    Content="{StaticResource FontAwesomeSearchIcon}"
                    Command="{Binding SearchCommand}"
                    Padding="4" Background="{DynamicResource WordOrangeBrush}" Height="40" Width="60" RenderTransformOrigin="1.221,0.593" AutomationProperties.HelpText="Search for items in the hierarchy" 
                  >
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource ForegroundLight}"/>
                    </Button.Foreground>
                    <!--<Button.ToolTip>
                    <ToolTip Placement="Mouse"

                         Opened="ToolTip_Opened"

                         Closed="ToolTip_Closed">Login with the entered credentials</ToolTip>
                </Button.ToolTip>-->
                </Button>
                <TextBox
                Text="F2 to view transactions, Enter to access Cost Element ">
                </TextBox>
            </StackPanel>
        </Border>
        <Border 
     DockPanel.Dock="Top" 
     BorderBrush="#FF734444" 
     BorderThickness="1,0,1,1">


            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!--Settings Title-->

                <Grid  Grid.Row ="0"  Height="20" Margin="0 0 0 2">


                    <!--Back button-->

                    <Button Style="{StaticResource IconGrowButton}"
                Height="40"
                Content="{StaticResource FontAwesomeArrowLeftIcon}"
                FontFamily="{StaticResource FontAwesome}"
                Foreground="{StaticResource ForegroundDarkBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding CloseCommand}" IsCancel="True"
                />


                    <!--Settings header-->

                    <TextBlock FontSize="{StaticResource FontSizeLarge}"

                   Foreground="{StaticResource ForegroundVeryDarkBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            
         <!--Tree icon--> 
        
            <Run FontFamily="{StaticResource FontAwesome}"
                 Text="{StaticResource FontAwesomeProjectIcon}"                     
                 Foreground="{StaticResource WordOrangeBrush}" />
            
         <!--Settings text--> 
        
            <Run Text="{Binding ControlTitle}"
                 Foreground="{DynamicResource WordDarkBlueBrush}"
                 FontFamily="{DynamicResource LatoBold}" Background="{DynamicResource BackgroundVeryLightBrush}" />
                    </TextBlock>

                </Grid>
            </Grid>
        </Border>
        <Border         DockPanel.Dock="Top" 
     BorderBrush="#FF734444" 
     BorderThickness="1,0,1,1">

            <!--<Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                --><!--<StackPanel Grid.IsSharedSizeScope="True" Orientation="Vertical">--><!--
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>

                        --><!--<ColumnDefinition Width="150" />--><!--
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="220" />

                    </Grid.ColumnDefinitions>

                    <TextBlock  Grid.Column ="1"  Width="220"  HorizontalAlignment="Right"    TextWrapping="WrapWithOverflow" Text="Cost Category" FontFamily="Lato Medium" FontWeight="ExtraBold"  Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                    <TextBlock  Grid.Column ="2"  Width="220"  HorizontalAlignment="Right"    TextWrapping="WrapWithOverflow" Text="Budget Amount(This level)" FontFamily="Lato Medium"  FontWeight="ExtraBold" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                    <TextBlock  Grid.Column ="3"  Width="220"  HorizontalAlignment="Right"    TextWrapping="WrapWithOverflow" Text="Budget Amount(Descendant only)" FontFamily="Lato Medium"  FontWeight="ExtraBold" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                    <TextBlock  Grid.Column ="4"  Width="220"  HorizontalAlignment="Right"    TextWrapping="WrapWithOverflow" Text="Budget Amount Total(All levels) " FontFamily="Lato Medium"  FontWeight="ExtraBold" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>

                </Grid>

            </Grid>-->



        </Border>
        <ScrollViewer x:Name="scrollViewer"  Focusable="True" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4" BorderThickness="2">


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewKeyDown" >
                        <i:InvokeCommandAction 
                    Command="{Binding GestureHandlerCommand}"
                    EventArgsConverter="{StaticResource ContextualEventArgsConverter}"
                    EventArgsConverterParameter="{Binding ElementName=tvParameters,Path=SelectedItem}" />

                    </i:EventTrigger>

                    <i:EventTrigger EventName="PreviewMouseDoubleClick" >
                        <i:InvokeCommandAction 
                    Command="{Binding GestureHandlerCommand}"
                    EventArgsConverter="{StaticResource ContextualEventArgsConverter}"
                    EventArgsConverterParameter="{Binding ElementName=tvParameters,Path=SelectedItem}" />

                    </i:EventTrigger>

                    <i:EventTrigger EventName="PreviewMouseRightButtonClick" >
                        <i:InvokeCommandAction 
                    Command="{Binding GestureHandlerCommand}"
                    EventArgsConverter="{StaticResource ContextualEventArgsConverter}"
                    EventArgsConverterParameter="{Binding ElementName=tvParameters,Path=SelectedItem}" />

                    </i:EventTrigger>


                </i:Interaction.Triggers>



                <TreeView Grid.Row="1"
                      ItemsSource="{Binding FirstGeneration}" 
                      TreeViewItem.Selected="TreeView_Selected"            
                      Name="tvParameters">

                    <!--<TreeView.Template>
                            <ControlTemplate>
                                <Border BorderBrush="{TemplateBinding BorderBrush}"  BorderThickness="{TemplateBinding BorderThickness}"  SnapsToDevicePixels="true">

                                    <ItemsPresenter x:Name="ItemsPresenter" Grid.ColumnSpan="10" Grid.Column="0" Grid.Row="2" Margin="-5,0,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </TreeView.Template>-->

                    <!--AllowDrop="True"  MouseDown="TreeView_MouseDown"  Drop="TreeView_Drop" MouseMove="TreeView_MouseMove">-->

                    <TreeView.ItemContainerStyle>
                        <!-- 
                    This Style binds a TreeViewItem to a HierarchyViewModel. 
                    -->

                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="AllowDrop"  Value="True"/>
                            <Setter Property="FontWeight" Value="Normal" />
                            <EventSetter Event="DragOver"  Handler="TreeView_DragOver"/>
                            <EventSetter Event="Drop" Handler="TreeView_Drop"/>
                            <EventSetter Event= "MouseDown" Handler="TreeView_MouseDown"/>
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeView_PreviewMouseLeftButtonDown" />
                            <EventSetter Event="KeyDown" Handler="TreeView_KeyBoard"/>
                            <EventSetter Event="MouseMove" Handler="TreeView_MouseMove"/>
                            <EventSetter Event="MouseDoubleClick" Handler="TreeView_MouseDoubleClick"/>
                            <!--<EventSetter Event="MouseEnter" Handler="TreeView_MouseEnter"/>
                                <EventSetter Event="MouseLeave" Handler="TreeView_MouseLeave"/>-->
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="UltraBold" />
                                    <Setter Property="Foreground" Value="Darkred"/>
                                    <!--<Setter Property="Cursor" Value="Hand"/>-->
                                </Trigger>

                                <Trigger Property="local:MyTreeViewHelper.IsMouseDirectlyOverItem" Value="True">
                                    <Setter Property="FontWeight" Value="Black" />
                                    <!--<Setter Property="Background" Value="Blue" />
                                    <Setter Property="Foreground" Value="Blue"/>-->
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}"  >
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"  Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column ="1" Width="220"  HorizontalAlignment="Right"  TextWrapping="WrapWithOverflow" Text="{Binding ShortName}" FontFamily="Lato Medium" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                                    <TextBlock  Grid.Column ="2" Width="220"  HorizontalAlignment="Right"    TextWrapping="WrapWithOverflow" Text="{Binding BudgetAmount,StringFormat=C,ConverterCulture='en-ZA'}" FontFamily="Lato Medium" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                                    <TextBlock  Grid.Column ="3" Width="220"  HorizontalAlignment="Right"    TextWrapping="WrapWithOverflow" Text="{Binding BudgetAmountDescendants,StringFormat=C,ConverterCulture='en-ZA'}" FontFamily="Lato Medium" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                                    <TextBlock  Grid.Column ="4" Width="220"  HorizontalAlignment="Right"    TextWrapping="WrapWithOverflow" Text="{Binding BudgetAmountTotal,StringFormat=C,ConverterCulture='en-ZA'}" FontFamily="Lato Medium" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                                    <ItemsPresenter x:Name="ItemsPresenter" Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="1" Margin="-5,0,0,0"/>

                                </Grid>

                            </StackPanel>

                        </HierarchicalDataTemplate>

                    </TreeView.ItemTemplate>
                    
                    
                </TreeView>

                <!--</StackPanel>-->
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>

