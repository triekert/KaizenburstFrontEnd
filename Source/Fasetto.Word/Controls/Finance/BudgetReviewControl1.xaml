<UserControl x:Class="Fasetto.Word.BudgetReviewControl1" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"    
  
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Fasetto.Word"             
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <local:ContextualEventArgsConverter x:Key="ContextualEventArgsConverter" />
    </UserControl.Resources>
    <DockPanel>
        <!-- SEARCH AREA -->
        <Border 
         DockPanel.Dock="Bottom" 
         BorderBrush="#FFE22626" 
         BorderThickness="2,0,2,2">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#11A49090" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel 
                HorizontalAlignment="Stretch" 
                Margin="0,0,10,0" 
                Orientation="Horizontal"
                >
                <TextBox 
                      x:Name="searchTextBox"
                      KeyDown="SearchTextBox_KeyDown"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      Width ="400" FontSize="18" TextWrapping="Wrap" RenderTransformOrigin="0.1,0.616" AutomationProperties.HelpText="Begin entering name...."
                    >
                    <TextBox.InputBindings>
                        <!--Clear text on Esc-->
                        <KeyBinding Command="{Binding ClearSearchCommand}" Key="Esc" />
                        <!--Search on enter-->
                        <KeyBinding Command="{Binding SearchCommand}" Key="Return" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Style="{StaticResource IconGrowButton}" 
                        Content="{StaticResource FontAwesomeSearchIcon}"
                        Command="{Binding SearchCommand}"
                        Padding="4" Background="{DynamicResource WordOrangeBrush}" Height="40" Width="60" RenderTransformOrigin="1.221,0.593" AutomationProperties.HelpText="Search for items in the hierarchy" 
                      >
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource ForegroundLight}"/>
                    </Button.Foreground>
                    <!--<Button.ToolTip>
                        <ToolTip Placement="Mouse"

                             Opened="ToolTip_Opened"

                             Closed="ToolTip_Closed">Login with the entered credentials</ToolTip>
                    </Button.ToolTip>-->
                </Button>
                <TextBox
                    Text="F2 to view transactions, Enter to access Cost Element ">
                </TextBox>
            </StackPanel>
        </Border>
        <Border 
         DockPanel.Dock="Top" 
         BorderBrush="#FF734444" 
         BorderThickness="1,0,1,1">


            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!--Settings Title-->

                <Grid  Grid.Row ="0"  Height="20" Margin="0 0 0 2">


                    <!--Back button-->

                    <Button Style="{StaticResource IconGrowButton}"
                    Height="40"
                    Content="{StaticResource FontAwesomeArrowLeftIcon}"
                    FontFamily="{StaticResource FontAwesome}"
                    Foreground="{StaticResource ForegroundDarkBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}" IsCancel="True"
                    />


                    <!--Settings header-->

                    <TextBlock FontSize="{StaticResource FontSizeLarge}"

                       Foreground="{StaticResource ForegroundVeryDarkBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                
             <!--Tree icon--> 
            
                <Run FontFamily="{StaticResource FontAwesome}"
                     Text="{StaticResource FontAwesomeProjectIcon}"                     
                     Foreground="{StaticResource WordOrangeBrush}" />
                
             <!--Settings text--> 
            
                <Run Text="{Binding ControlTitle}"
                     Foreground="{DynamicResource WordDarkBlueBrush}"
                     FontFamily="{DynamicResource LatoBold}" Background="{DynamicResource BackgroundVeryLightBrush}" />
                    </TextBlock>

                </Grid>
            </Grid>
        </Border>
        <Border        
            DockPanel.Dock="Top" 
         BorderBrush="#FF734444" 
         BorderThickness="1,0,1,1">


            <!--<StackPanel Grid.IsSharedSizeScope="True" Orientation="Vertical">-->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25"/>

                    <!--<ColumnDefinition Width="150" />-->
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />

                </Grid.ColumnDefinitions>

                <TextBlock  Grid.Column ="1"  Width="200"  TextAlignment="Center"    TextWrapping="WrapWithOverflow" Text=" Cost Category" FontFamily="Lato Medium" FontWeight="ExtraBold"  Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                <TextBlock  Grid.Column ="2"  Width="100"  HorizontalAlignment="Right"    TextAlignment ="Right" TextWrapping="WrapWithOverflow" Text="Budget Amount(This level)" FontFamily="Lato Medium"  FontWeight="ExtraBold" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                <TextBlock  Grid.Column ="3"  Width="100"  HorizontalAlignment="Right"      TextAlignment ="Right" TextWrapping="WrapWithOverflow" Text="Budget Amount(Descendant only)" FontFamily="Lato Medium"  FontWeight="ExtraBold" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                <TextBlock  Grid.Column ="4"  Width="100"  HorizontalAlignment="Right"      TextAlignment ="Right" TextWrapping="WrapWithOverflow" Text="Budget Amount Total(All levels) " FontFamily="Lato Medium"  FontWeight="ExtraBold" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>


            </Grid>



        </Border>
        <ScrollViewer x:Name="scrollViewer"  Focusable="True" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4" BorderThickness="2">


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewKeyDown" >
                        <i:InvokeCommandAction 
                        Command="{Binding GestureHandlerCommand}"
                        EventArgsConverter="{StaticResource ContextualEventArgsConverter}"
                        EventArgsConverterParameter="{Binding ElementName=tvParameters,Path=SelectedItem}" />

                    </i:EventTrigger>

                    <i:EventTrigger EventName="PreviewMouseDoubleClick" >
                        <i:InvokeCommandAction 
                        Command="{Binding GestureHandlerCommand}"
                        EventArgsConverter="{StaticResource ContextualEventArgsConverter}"
                        EventArgsConverterParameter="{Binding ElementName=tvParameters,Path=SelectedItem}" />

                    </i:EventTrigger>

                    <i:EventTrigger EventName="PreviewMouseRightButtonClick" >
                        <i:InvokeCommandAction 
                        Command="{Binding GestureHandlerCommand}"
                        EventArgsConverter="{StaticResource ContextualEventArgsConverter}"
                        EventArgsConverterParameter="{Binding ElementName=tvParameters,Path=SelectedItem}" />

                    </i:EventTrigger>


                </i:Interaction.Triggers>

                <local:TreeListView
            ChildrenPropertyName="Children"
            x:Name="tvParameters"                   
            ItemsSource="{Binding FirstGeneration}"    
            TreeViewItem.Selected="TreeView_Selected" 
  
            Style="{StaticResource VirtualizedMetroTreeListView}">
                    <local:TreeListView.View>
                        <GridView>
                            <GridViewColumn Width="200" Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock 
                                                   FontFamily="Lato Medium" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"
                                                   Text="{Binding ShortName}" 
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn
                                Width="150"
                                Header="Budget Total" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="Brown" Text="{Binding BudgetAmountTotal, StringFormat=C,ConverterCulture='en-ZA' }"
                                                   TextAlignment="Right" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn
                                Width="150"
                                Header="Budget Total" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="Brown" Text="{Binding BudgetAmountDescendants, StringFormat=C,ConverterCulture='en-ZA' }"
                                                   TextAlignment="Right" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>


                            <GridViewColumn
                                Width="150"
                                Header="Description" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="Brown" Text="{Binding BudgetAmountTotal, StringFormat=C,ConverterCulture='en-ZA' }"
                                                   TextAlignment="Right" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>    
                            
                            <GridViewColumn
                                Width="200"
                                DisplayMemberBinding="{Binding Description}"
                                Header="Something New" />
                        </GridView>
                    </local:TreeListView.View>
                </local:TreeListView>
            </Grid>
        </ScrollViewer>
    </DockPanel>




</UserControl>

