<UserControl x:Class="Fasetto.Word.HierarchyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Fasetto.Word"             
             d:DesignHeight="300" d:DesignWidth="300">

    <DockPanel>
        <!-- SEARCH AREA -->
        <Border 
      DockPanel.Dock="Bottom" 
      BorderBrush="#FF734444" 
      BorderThickness="1,0,1,1"
      >
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#11000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel 
                HorizontalAlignment="Right" 
                Margin="0,0,10,0" 
                Orientation="Horizontal"
                >
                <TextBox 
                      x:Name="searchTextBox"
                      KeyDown="SearchTextBox_KeyDown"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      Width="150" FontSize="18" TextWrapping="Wrap" RenderTransformOrigin="0.1,0.616"
                  />
                <Button 
                      Command="{Binding SearchCommand}" 
                      Content="Find" 
                      HorizontalAlignment="Left"
                      Padding="4,4" Background="{DynamicResource WordOrangeBrush}" Height="35" Width="120" RenderTransformOrigin="1.221,0.593" 
                      >
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource ForegroundLight}"/>
                    </Button.Foreground>
                </Button>
            </StackPanel>
        </Border>

        <!-- FAMILY TREE -->
        <ScrollViewer x:Name="scrollViewer" Focusable="False" FocusManager.IsFocusScope="False">
            <TreeView 
              ItemsSource="{Binding FirstGeneration}" 
              TreeViewItem.Selected="TreeView_Selected"            
              Name="tvParameters">
                <!--AllowDrop="True"  MouseDown="TreeView_MouseDown"  Drop="TreeView_Drop" MouseMove="TreeView_MouseMove">-->

                <TreeView.ItemContainerStyle>
                    <!-- 
            This Style binds a TreeViewItem to a HierarchyViewModel. 
            -->
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="AllowDrop"  Value="True"/>
                        <Setter Property="FontWeight" Value="Normal" />
                        <EventSetter Event="DragOver"  Handler="TreeView_DragOver"/>
                        <EventSetter Event="Drop" Handler="TreeView_Drop"/>
                        <EventSetter Event= "MouseDown" Handler="TreeView_MouseDown"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeView_PreviewMouseLeftButtonDown" />

                        <EventSetter Event="MouseMove" Handler="TreeView_MouseMove"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="UltraBold" />
                                 <Setter Property="Foreground" Value="Darkred"/>
                                <!--<Setter Property="Cursor" Value="Hand"/>-->
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"  Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                            <TextBlock Text="{Binding ShortName}" FontFamily="Lato Medium" Foreground="{Binding TextColor, Converter={local:StringRGBToBrushConverter}}"/>
                            <!--<TextBlock Text="-"/>-->
                            <!--<TextBlock Text="{Binding KCategoryID}"/>-->


                        </StackPanel>
                        <!--<TextBlock Text="{Binding KCategoryId}" />-->
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </ScrollViewer>

    </DockPanel>
</UserControl>

