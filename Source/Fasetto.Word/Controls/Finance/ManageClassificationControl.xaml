<UserControl x:Class="Fasetto.Word.ManageClassificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fasetto.Word" xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms" xmlns:sys="clr-namespace:System;assembly=mscorlib" d:DataContext="{d:DesignInstance Type=local:BulkReconViewModel}"
             xmlns:core="clr-namespace:Fasetto.Word.Core;assembly=Fasetto.Word.Core"
             mc:Ignorable="d" >
    <UserControl.Resources>
        <sys:String x:Key="colName">dynamic string...</sys:String>
        <Style x:Key="ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" >
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Label Foreground="{StaticResource ForegroundVeryDarkBrush}" FontWeight="UltraBold" Background="{StaticResource WordLightBlueBrush}" FontFamily="Lato Heavy" FontSize="20" Content="{TemplateBinding Content}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment ="Left"  VerticalAlignment="Center"  />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource BackgroundLightBrush}" 
            Padding="15">


                <ScrollViewer x:Name="scrollViewer"  Focusable="True" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

        <Grid   Keyboard.PreviewKeyDown="TreeView_KeyBoard" ForceCursor="True">


            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Settings Title -->
            <Grid Height="30" Margin="0 0 0 20">

                <!-- Back button -->
                <Button  

                    Style="{StaticResource IconGrowButton}"
                    Height="50"
                    Content="{StaticResource FontAwesomeArrowLeftIcon}"
                    FontFamily="{StaticResource FontAwesome}"
                    Foreground="{StaticResource  WordOrangeBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}" IsCancel="True" IsDefault="True"/>
                <!--Keyboard.KeyDown="TreeView_KeyBoard"-->

                <!-- Settings header -->
                <TextBlock FontSize="{StaticResource FontSizeLarge}"
                       Foreground="{StaticResource ForegroundVeryDarkBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,281,0">
                <!-- Cog icon -->
                <Run FontFamily="{StaticResource FontAwesome}"
                     Text="{StaticResource FontAwesomeCogIcon}"
                     Foreground="{StaticResource WordOrangeBrush}" />
                <!-- Settings text -->
                <Run Text="{Binding HeadingText}" 
                     FontFamily="{StaticResource LatoRegular}" 
                     FontWeight="Bold"
                     />
                </TextBlock>

            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1"
                  Width="800"
                  VerticalAlignment="Top"
                  >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- Profile Picture -->
                <Grid Margin="0 0 30 0"
                      VerticalAlignment="Top"
                      Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">

                    <!-- Mask for rounded corners-->
                    <Border CornerRadius="8"
                            Name="Mask"
                            Background="White"
                            />

                    <!-- Image -->
                        <Grid>

                            <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=Mask}" />
                        </Grid.OpacityMask>

                        <Image Source="/Images/Logo/KaizenPNG.PNG" Stretch="UniformToFill" />
                    </Grid>

                </Grid>
                    <!-- Profile details -->
                    <StackPanel Grid.Column="1"
                                local:TextEntryWidthMatcherProperty.Value="True">
                        <StackPanel Grid.Column="1"
                                local:TextEntryWidthMatcherProperty.Value="True">
                        
                            <StackPanel Orientation="Horizontal" Grid.Column="1" 
                                        local:TextEntryWidthMatcherProperty.Value="True" d:IsHidden="True">
                                <TextBlock  Text ="Date of Transaction : " FontFamily="{StaticResource LatoRegular}" 
                                               Padding="10 10 10 10" FontWeight="Bold"/>
                                <TextBlock  Text ="{Binding TransactionDate}" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>                    
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Grid.Column="1" 
                                        local:TextEntryWidthMatcherProperty.Value="True" d:IsHidden="True">
                                <TextBlock  Text ="Transaction Description: " FontFamily="{StaticResource LatoRegular}" 
                                               Padding="10 10 10 10" FontWeight="Bold"/>
                                <TextBlock  Text ="{Binding TransactionDetail}" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>


                            </StackPanel>
                            <local:TextEntryControl DataContext="{Binding TransactionDescription}" FontWeight="ExtraBlack"  />
                            <local:TextEntryControl DataContext="{Binding TransactionNotes}" FontWeight="ExtraBlack"  />
                            <local:TextEntryControl DataContext="{Binding Allocation}" FontWeight="ExtraBlack"  />
                            <!--<StackPanel MouseEnter="SetHierarchySelection">-->
                            <local:HierarchyItemSelectionControl DataContext="{Binding Category}" FontWeight="ExtraBlack"  />
                            <!--<StackPanel MouseEnter="SetHierarchySelection">-->
                            <local:HierarchyItemSelectionControl DataContext="{Binding Party}" FontWeight="ExtraBlack"  /> 
                            <!--</StackPanel>-->
                            <!--</StackPanel>-->
                            <!--<Grid >
                                <TextBox x:Name="ImagePath" 
                                    
                                     Text ="{Binding Document.DocURL}" FontFamily="{StaticResource LatoRegular}" FontSize="12"
                                     />
                            </Grid>
                            --><!--<Button x:Name="BrowseButton" Content="..." Click="BrowseButton_OnClick"/>
                            <Button x:Name="SaveButton" Content="Save" Click="SaveButton_OnClick"/>
                            <Button x:Name="LoadButton" Content="Load" Click="LoadButton_OnClick" />-->
                            <!--<Image x:Name="MyImage" >
                                <Image.Source>
                                    --><!--<BitmapImage UriSource="{Binding = DocURL, Path=Text}" />--><!--
                                 Source="{Binding LocalFilePath, NotifyOnTargetUpdated=True}"                               
                                </Image.Source>


                            </Image>--><!--
                                
                            <Border CornerRadius="10"
                                Margin="0 0 0 15">

                                <Image 

                                   local:ClipFromBorderProperty.Value="True"
                                   local:FadeInImageOnLoadProperty.Value="True"
                                   Source="{Binding  Document.DocImage}"
                                   MaxWidth="100"
                                   />

                            </Border>-->
                        
                                    <!--DataContext="{Binding ImageAttachment}", NotifyOnTargetUpdated=True-->
                            <!--Source="{Binding  DocURL}"-->
                        </StackPanel>

                        <DataGrid x:Name="Transaction" Grid.Row="3"  ItemsSource="{Binding DocumentList}" 
                 HeadersVisibility="All" RenderTransformOrigin="0.5,0.5"       GridLinesVisibility="None" 
                   AutoGenerateColumns="False" AlternationCount="2"
                   SelectionMode="Single" SelectionUnit="FullRow"  VerticalAlignment="Center"  HorizontalAlignment="Center" HorizontalContentAlignment="Center"  CanUserAddRows="False"
                 >
                            <DataGrid.ColumnHeaderStyle>
                               <Style TargetType="{x:Type DataGridColumnHeader}">
                                   <Setter Property="FontWeight"  Value="ExtraBold" />
                                   <Setter Property="HorizontalAlignment" Value="Center" />
                                   <Setter Property="HorizontalContentAlignment" Value="Center" />
                               </Style>
                           </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event ="MouseDoubleClick"  Handler="DataGridRow_MouseDoubleClick"/>
                                    <EventSetter Event ="KeyDown"  Handler="DataGridRow_KeyDown"/>
                                    <EventSetter Event ="PreviewMouseRightButtonDown"  Handler="DataGridRow_MouseRightClick"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Background" Value ="AliceBlue"/>

                                    <!--Setting highlight-->
                                    <Style.Triggers>
                                        <Trigger Property="AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="{StaticResource  WordOrangeBrush}"/>
                                            <Setter Property="Foreground" Value="DarkGray"></Setter>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ShortName}" Value ="">
                                            <Setter Property="Background" Value="Crimson"></Setter>
                                            <Setter Property="Foreground" Value="Beige"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KPartyName}" Value ="">
                                            <Setter Property="Background" Value="Crimson"></Setter>
                                            <Setter Property="Foreground" Value="Beige"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRemove}" Value = "true">
                                            <Setter Property="Background" Value="{StaticResource  WordOrangeBrush}"></Setter>
                                            <Setter Property="Foreground" Value="DarkCyan"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <!--Setting highlight-->

                                </Style>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <!--<DataGridTextColumn Header ="Bulk Meter" FontWeight="Bold"
                                   Binding="{Binding ShortName}"/>-->

                                <DataGridTemplateColumn Header="Document Description" HeaderStyle="{StaticResource ColumnHeaderStyle}" SortDirection="Descending">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="5" TextWrapping="Wrap"  Width="200" Text="{Binding Path= DocDescription}"  FontSize="12" FontWeight="Normal" FontFamily="Lato Heavy"  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Unique Identifier" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="5" Width="100" Text="{Binding Path= KDocID}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Linked Document" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image  Source="{Binding DocImage}"
                                               MaxWidth="100"      
                                                    />
                                            <!--<Border CornerRadius="10"
                                Margin="0 0 0 15">-->

                                                <!--<Image--> 

                                   <!--local:ClipFromBorderProperty.Value="True"
                                   local:FadeInImageOnLoadProperty.Value="True"
                                 
                                  
                                   />-->

                                            <!--</Border>-->
                                            <!--<TextBlock Margin="5" TextWrapping="Wrap"  Width="200" Text="{Binding Path= ShortName}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>-->
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Linked Party" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="5" TextWrapping="Wrap"  Width="200" Text="{Binding Path= KPartyName}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Assigned Value" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="5" Width="100" Text="{Binding Path=ActualAmount,StringFormat=C,ConverterCulture='en-ZA'}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>


                            </DataGrid.Columns>



                        </DataGrid>








                        <StackPanel    Grid.Column="0"
                            Orientation="Horizontal">
                        
                        
                        
                            <!--Add a classifcation to a transaction-->

                            <Button  Content="{Binding AddClassificationButtonText}"
                                Command="{Binding AddClassificationCommand}"
                                FontSize="{StaticResource FontSizeRegular}"
                                Visibility="{Binding AddClassificationButtonText, ConverterParameter=True, Converter={local:TextToVisiblityConverter}}" Margin="-0,10,0,10" d:IsHidden="True" 
                                />

                            <!--Change a classification for a transaction -classifcation type or allocation amount-->

                            <Button  Content="{Binding AlterTemplateButtonText}"
                                Command="{Binding AlterTemplateCommand}"
                                FontSize="{StaticResource FontSizeRegular}"
                                Visibility="{Binding AlterTemplateButtonText, ConverterParameter=True, Converter={local:TextToVisiblityConverter}}" Margin="-0,10,0,10" d:IsHidden="True" 
                                />
                            <!--Remove a clasification for a transaction-->
                            <!--<Button Content="{Binding DeleteClassificationButtonText}"
                                Command="{Binding BrowseImageCommand}"
                                FontSize="{StaticResource FontSizeRegular}"
                             
                                />-->

                        </StackPanel>

                        <!--<StackPanel Grid.Column="0"                    
                    
                    <TextBox x:Name="ImagePath" />

                                
                        </StackPanel>-->
                    </StackPanel>

            </Grid>


            </Grid>
      </ScrollViewer>
     
    </Border>
</UserControl>
