<UserControl x:Class="Fasetto.Word.TransactionDetailControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Fasetto.Word" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             d:DataContext="{d:DesignInstance Type=local:TransactionDetailViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <sys:String x:Key="colName">dynamic string...</sys:String>

        
        
        <!-- Custom Column Header Style -->
        <Style x:Key="ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Label Foreground="DarkRed" 
                               FontWeight="ExtraBlack" 
                               Background="BurlyWood" 
                               FontFamily="Lato Heavy" 
                               FontSize="20" 
                               Content="{TemplateBinding Content}"
                               HorizontalAlignment="Stretch" 
                               HorizontalContentAlignment="Left"  
                               VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- SEARCH AREA (BOTTOM) -->
        <Border DockPanel.Dock="Bottom" 
                BorderBrush="#FFE22626" 
                BorderThickness="2,0,2,2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#11A49090" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- TOP BAR / INPUT CONTROLS -->
        <Border DockPanel.Dock="Top" 
                BorderBrush="#FF734444" 
                BorderThickness="2,1,2,1">
            <StackPanel>
                <!-- Header Title Bar -->
                <Grid Height="40" Margin="0,5,0,5">
                    <Button Style="{StaticResource IconGrowButton}"
                            Width="40" Height="40"
                            Content="{StaticResource FontAwesomeArrowLeftIcon}"
                            FontFamily="{StaticResource FontAwesome}"
                            Foreground="{StaticResource ForegroundDarkBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding CloseCommand}"/>

                    <TextBlock FontSize="{StaticResource FontSizeLarge}"
                               Foreground="{StaticResource ForegroundVeryDarkBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <Run FontFamily="{StaticResource FontAwesome}"
                             Text="{StaticResource FontAwesomeProjectIcon}"                     
                             Foreground="{StaticResource WordOrangeBrush}" />
                        <Run Text="{Binding ControlTitle}"
                             Foreground="{DynamicResource WordDarkBlueBrush}"
                             FontFamily="{DynamicResource LatoBold}" 
                             Background="{DynamicResource BackgroundVeryLightBrush}" />
                    </TextBlock>
                </Grid>

                <!-- Input Controls StackPanel -->
                <!-- Input Controls Grid -->
                <Grid Margin="5" local:TextEntryWidthMatcherProperty.Value="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. First control spans across both columns on top -->
                    <local:DateTimeControl Grid.Row="0" Grid.ColumnSpan="2" 
                           DataContext="{Binding TransactionDate}" 
                           FontWeight="ExtraBlack" 
                           Margin="0,2" />

                    <!-- 2. Row 1: Description (Left) & Amount (Right) -->
                    <local:TextEntryControl Grid.Row="1" Grid.Column="0" 
                            DataContext="{Binding TransactionDescription}" 
                            FontWeight="ExtraBlack" 
                            Margin="0,2,2,2" />
                    <local:TextEntryControl Grid.Row="1" Grid.Column="1" 
                            DataContext="{Binding Amount}" 
                            FontWeight="ExtraBlack" 
                            Margin="2,2,0,2" />

                    <!-- 3. Row 2: Party (Left) & Account (Right) -->
                    <local:HierarchyItemSelectionControl Grid.Row="2" Grid.Column="0" 
                                         DataContext="{Binding Party}" 
                                         FontWeight="ExtraBlack" 
                                         Margin="0,2,2,2" />
                    <local:HierarchyItemSelectionControl Grid.Row="2" Grid.Column="1" 
                                         DataContext="{Binding Account}" 
                                         FontWeight="ExtraBlack" 
                                         Margin="2,2,0,2" />
                </Grid>

                <!-- Add Classification Button -->
                <Button x:Name="TransactionEditButton"
                    Content="{Binding TransactionEditButtonText}"
                    Command="{Binding TransactionEditCommand}"
                    FontSize="{StaticResource FontSizeRegular}"
                    HorizontalAlignment="Center"
                    Padding="15,5"
                    Visibility="{Binding TransactionEditButtonText, ConverterParameter=True, Converter={local:TextToVisiblityConverter}}" 
                    Margin="0,10,0,10" d:IsHidden="True"/>
            </StackPanel>
        </Border>

        <!-- MAIN DATAGRID -->
        <DataGrid x:Name="TransactionDetail" 
                  ItemsSource="{Binding TransactionDetail}" 
                  HeadersVisibility="All" 
                  GridLinesVisibility="None" 
                  AutoGenerateColumns="False" 
                  AlternatingRowBackground="Beige" 
                  SelectionMode="Single" 
                  SelectionUnit="FullRow"  
                  VerticalAlignment="Center" 
                  HorizontalAlignment="Center" 
                  CanUserAddRows="False">

            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                    <EventSetter Event="KeyDown" Handler="DataGridRow_KeyDown"/>
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_MouseRightClick"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="Cyan"/>

                    <!-- State Triggers & Mouse-Over Trigger -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="State1">
                            <Setter Property="Background" Value="Red"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="State2">
                            <Setter Property="Background" Value="Orange"/>
                        </DataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Transaction Category" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5" TextWrapping="Wrap" Width="200" Text="{Binding Path=ShortName}" FontSize="12" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Units" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5" Width="100" Text="{Binding Path=Units, ConverterCulture='en-ZA'}" FontSize="12" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Assigned Value" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5" Width="100" Text="{Binding Path=ActualAmount, StringFormat=C, ConverterCulture='en-ZA'}" FontSize="12" FontFamily="arial" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>