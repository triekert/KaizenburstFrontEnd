<UserControl x:Class="Fasetto.Word.StockHoldingAdjustControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fasetto.Word"
             xmlns:core="clr-namespace:Fasetto.Word.Core;assembly=Fasetto.Word.Core"
             d:DataContext="{x:Static local:HierarchyElementDesignModel.Instance}"
             mc:Ignorable="d" >

    <Border Background="{DynamicResource BackgroundLightBrush}" 
            Padding="15">



        <Grid                      Keyboard.PreviewKeyDown="TreeView_KeyBoard" ForceCursor="True">


            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Settings Title -->
            <Grid Height="30" Margin="0 0 0 20">

                <!-- Back button -->
                <Button  

                    Style="{StaticResource IconGrowButton}"
                    Height="50"
                    Content="{StaticResource FontAwesomeArrowLeftIcon}"
                    FontFamily="{StaticResource FontAwesome}"
                    Foreground="{StaticResource  WordOrangeBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}" IsCancel="True" IsDefault="True"/>
                <!--Keyboard.KeyDown="TreeView_KeyBoard"-->

                <!-- Settings header -->
                <TextBlock FontSize="{StaticResource FontSizeLarge}"
                       Foreground="{StaticResource ForegroundVeryDarkBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <!-- Cog icon -->
                <Run FontFamily="{StaticResource FontAwesome}"
                     Text="{StaticResource FontAwesomeCogIcon}"
                     Foreground="{StaticResource WordOrangeBrush}" />
                <!-- Settings text -->
                <Run Text="{Binding HeadingText}" 
                     FontFamily="{StaticResource LatoRegular}" 
                     FontWeight="Bold"
                     />
                </TextBlock>

            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1"
                  Width="800"
                  VerticalAlignment="Top"
                  >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- Profile Picture -->
                <Grid Margin="0 0 30 0"
                      VerticalAlignment="Top"
                      Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">

                    <!-- Mask for rounded corners-->
                    <Border CornerRadius="8"
                            Name="Mask"
                            Background="White"
                            />

                    <!-- Image -->
                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=Mask}" />
                        </Grid.OpacityMask>

                        <Image Source="/Images/Samples/rusty.jpg" Stretch="UniformToFill" />
                    </Grid>

                </Grid>



                <!-- Profile details -->
                <StackPanel Grid.Column="1"
                            local:TextEntryWidthMatcherProperty.Value="True">
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                            local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Total Budget for Selected Month : " FontFamily="{StaticResource LatoBold}" 
                                               Padding="10 10 10 10" FontWeight="Bold" Foreground="{StaticResource ForegroundVeryDarkBrush}"/>
                        <TextBlock  Text ="{Binding BudgetAmountStr}" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                            local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Actual Total for Selected Month : " FontFamily="{StaticResource LatoBold}" 
                                               Padding="10 10 10 10" FontWeight="Bold" Foreground="{StaticResource ForegroundVeryDarkBrush}"/>
                        <TextBlock  Text ="{Binding BudgetAmountCumTotalStr}" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>

                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                            local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Total Cumulative Budget (To Date) : " FontFamily="{StaticResource LatoBold}" 
                                               Padding="10 10 10 10" FontWeight="Bold" Foreground="{StaticResource ForegroundVeryDarkBrush}"/>
                        <TextBlock  Text ="{Binding BudgetAmountTotalStr}" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                            local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Actual Cumulative Total (To Date): " FontFamily="{StaticResource LatoBold}" 
                                               Padding="10 10 10 10" FontWeight="Bold" Foreground="{StaticResource ForegroundVeryDarkBrush}"/>
                        <TextBlock  Text ="{Binding ActualAmountTotalStr }" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                            local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Variance from Budget(Month) : " FontFamily="{StaticResource LatoBold}" 
                                               Padding="10 10 10 10" FontWeight="Bold" Foreground="{StaticResource ForegroundVeryDarkBrush}"/>
                        <TextBlock  Text ="{Binding DeviationStr}" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                            local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Variance from Budget(To Date) : " FontFamily="{StaticResource LatoBold}" 
                                               Padding="10 10 10 10" FontWeight="Bold" Foreground="{StaticResource ForegroundVeryDarkBrush}"/>
                        <TextBlock  Text ="{Binding DeviationCumStr}" FontFamily="{StaticResource LatoRegular}" 
                                        Padding="10 10 10 10" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" 
                                local:TextEntryWidthMatcherProperty.Value="True">
                        <TextBlock  Text ="Start Date " FontFamily="{StaticResource LatoRegular}" 
                                       Padding="10 10 10 10" FontWeight="Bold"/>
                        <DatePicker x:Name="dateStart"  SelectedDate="{Binding DateStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="20 10 20 10"
                                        SelectedDateFormat="Short"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1"
                                    local:TextEntryWidthMatcherProperty.Value="True" RenderTransformOrigin="0.525,0.565">
                        <TextBlock  Text ="End Date  " FontFamily="{StaticResource LatoRegular}" 
                                           Padding="10 10 13 10" FontWeight="Bold"/>
                        <DatePicker x:Name="dateEnd"  SelectedDate="{Binding DateEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="20 10 20 10"
                                            SelectedDateFormat="Short"  />

                    </StackPanel>





                    <StackPanel    Grid.Column="0"
                        Orientation="Horizontal">
                        
                        

                        <Button Content="{Binding AdjustmentButtonText}"
                            Command="{Binding ExpenditureReviewCommand}"
                            FontSize="{StaticResource FontSizeRegular}"
                            />


                    </StackPanel>
                    <StackPanel    Grid.Column="0"
                        Orientation="Horizontal">



                        <Button Content="{Binding StockHoldingButtonText}"
                            Command="{Binding StockHoldingCommand}"
                            FontSize="{StaticResource FontSizeRegular}"
                            />


                    </StackPanel>

                </StackPanel>


            </Grid>


        </Grid>
    </Border>
</UserControl>
