<UserControl x:Class="Fasetto.Word.BulkReconControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Fasetto.Word" d:DataContext="{d:DesignInstance Type=local:BulkReconViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <DataTemplate x:Key="RowDetailTemplate">
            <Grid x:Name="RowDetailGrid"
			      Width="470"
			      Height="Auto"
			      Margin="5">

                <Border HorizontalAlignment="Left"
				        VerticalAlignment="Top"
				        CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="WhiteSmoke" />
                            <GradientStop Offset="0.75" Color="#AAFFFFAA" />
                            <GradientStop Offset="1" Color="#AAFFD455" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
						           Margin="10"
						           HorizontalAlignment="Center"
						           FontSize="18"
						           FontWeight="Black"
						           Text="Temperature Description" />
                        <TextBlock Grid.Row="1"
						           Margin="10"
						           HorizontalAlignment="Left"
						           Text="{Binding Description}"
						           TextWrapping="WrapWithOverflow" />
                    </Grid>
                </Border>
                <Border Margin="0 0 8 0" CornerRadius="5">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,1" GradientOrigin="0,1" Opacity="0.3" RadiusX="0.8" RadiusY="0.8">
                            <GradientStop Offset="1" Color="#AAFFD455" />
                            <GradientStop Offset="1" Color="WhiteSmoke" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>


    </UserControl.Resources>
       <DockPanel>
        <!-- SEARCH AREA -->
        <Border 
         DockPanel.Dock="Bottom" 
         BorderBrush="#FFE22626" 
         BorderThickness="2,0,2,2">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#11A49090" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <!--<StackPanel 
                HorizontalAlignment="Stretch" 
                Margin="0,0,10,0" 
                Orientation="Horizontal"
                >
                <TextBox 
                      x:Name="searchTextBox"
                      KeyDown="SearchTextBox_KeyDown"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      Width="200" Height="43" FontSize="18" TextWrapping="Wrap" RenderTransformOrigin="0.1,0.616" AutomationProperties.HelpText="Begin entering name...."
                    >
                    <TextBox.InputBindings>
                        --><!--Clear text on Esc--><!--
                        <KeyBinding Command="{Binding ClearSearchCommand}" Key="Esc" />
                        --><!--Search on enter--><!--
                        <KeyBinding Command="{Binding SearchCommand}" Key="Return" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Style="{StaticResource IconGrowButton}" 
                        Content="{StaticResource FontAwesomeSearchIcon}"
                        Command="{Binding SearchCommand}"
                        Padding="4" Background="{DynamicResource WordOrangeBrush}" Height="43" Width="88" RenderTransformOrigin="1.221,0.593" AutomationProperties.HelpText="Search for items in the hierarchy" 
                      >
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource ForegroundLight}"/>
                    </Button.Foreground>
                    --><!--<Button.ToolTip>
                        <ToolTip Placement="Mouse"

                             Opened="ToolTip_Opened"

                             Closed="ToolTip_Closed">Login with the entered credentials</ToolTip>
                    </Button.ToolTip>--><!--
                </Button>
            </StackPanel>-->
        </Border>
        <Border 
         DockPanel.Dock="Top" 
         BorderBrush="#FF734444" 
         BorderThickness="1,0,1,1">

            <Grid>

                <!--<Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>-->


                <!--Settings Title-->

                <Grid Height="20" Margin="0 0 0 2">


                    <!--Back button-->

                    <Button Style="{StaticResource IconGrowButton}"
                    Height="40"
                    Content="{StaticResource FontAwesomeArrowLeftIcon}"
                    FontFamily="{StaticResource FontAwesome}"
                    Foreground="{StaticResource ForegroundDarkBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}" IsCancel="True"
                    />


                    <!--Settings header-->

                    <TextBlock FontSize="{StaticResource FontSizeLarge}"

                       Foreground="{StaticResource ForegroundVeryDarkBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                
             <!--Tree icon--> 
            
                <Run FontFamily="{StaticResource FontAwesome}"
                     Text="{StaticResource FontAwesomeProjectIcon}"                     
                     Foreground="{StaticResource WordOrangeBrush}" />
                
             <!--Settings text--> 
            
                <Run Text="{Binding ControlTitle}"
                     Foreground="{DynamicResource WordDarkBlueBrush}"
                     FontFamily="{DynamicResource LatoBold}" Background="{DynamicResource BackgroundVeryLightBrush}" />
                    </TextBlock>


                    <!--FAMILY TREE-->

                </Grid>
            </Grid>
        </Border>

        <DataGrid x:Name="BulkRecon" Grid.Row="3"  ItemsSource="{Binding BulkRecon}" 
                  HeadersVisibility="All" RenderTransformOrigin="0.5,0.5"                    
                 AutoGenerateColumns="False" AlternatingRowBackground="Aqua"
              
                   RowDetailsTemplate="{StaticResource RowDetailTemplate}">
            <!--<DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight"  Value="ExtraBold" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.ColumnHeaderStyle>-->

            
            <DataGrid.Columns>
                <!--<DataGridTextColumn Header ="Bulk Meter" FontWeight="Bold"
                                    Binding="{Binding ShortName}"/>-->
                <DataGridTextColumn Header ="TimeSlot"
                                    Binding="{Binding TimeSlotStart}"/>
                <DataGridTextColumn Header ="Meters Missingr"
                                    Binding="{Binding  Missing}"/>
                <DataGridTextColumn Header ="Bulk Reading"
                                    Binding="{Binding VolumeIn}"/>
                <DataGridTextColumn Header ="Consumed"
                                    Binding="{Binding VolumeOut}"/>
                <DataGridTextColumn Header ="Mismatch"
                                    Binding="{Binding VolumeDelta}"/>
                <DataGridTextColumn Header ="MovingAvgDelta"
                                    Binding="{Binding  MovingAvgDelta}"/>
                <DataGridTextColumn Header ="Perc Delta"
                                    Binding="{Binding PercDelta}"/>                
            </DataGrid.Columns>


        </DataGrid>

    </DockPanel>
</UserControl>

