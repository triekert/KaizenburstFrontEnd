<UserControl x:Class="Fasetto.Word.BulkReconDetailControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Fasetto.Word" xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms" d:DataContext="{d:DesignInstance Type=local:BulkReconViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">


       <DockPanel>
        <!-- SEARCH AREA -->
        <Border 
         DockPanel.Dock="Bottom" 
         BorderBrush="#FFE22626" 
         BorderThickness="2,0,2,2">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#11A49090" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <!--<StackPanel 
                HorizontalAlignment="Stretch" 
                Margin="0,0,10,0" 
                Orientation="Horizontal"
                >
                <TextBox 
                      x:Name="searchTextBox"
                      KeyDown="SearchTextBox_KeyDown"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      Width="200" Height="43" FontSize="18" TextWrapping="Wrap" RenderTransformOrigin="0.1,0.616" AutomationProperties.HelpText="Begin entering name...."
                    >
                    <TextBox.InputBindings>
                        --><!--Clear text on Esc--><!--
                        <KeyBinding Command="{Binding ClearSearchCommand}" Key="Esc" />
                        --><!--Search on enter--><!--
                        <KeyBinding Command="{Binding SearchCommand}" Key="Return" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Style="{StaticResource IconGrowButton}" 
                        Content="{StaticResource FontAwesomeSearchIcon}"
                        Command="{Binding SearchCommand}"
                        Padding="4" Background="{DynamicResource WordOrangeBrush}" Height="43" Width="88" RenderTransformOrigin="1.221,0.593" AutomationProperties.HelpText="Search for items in the hierarchy" 
                      >
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource ForegroundLight}"/>
                    </Button.Foreground>
                    --><!--<Button.ToolTip>
                        <ToolTip Placement="Mouse"

                             Opened="ToolTip_Opened"

                             Closed="ToolTip_Closed">Login with the entered credentials</ToolTip>
                    </Button.ToolTip>--><!--
                </Button>
            </StackPanel>-->
        </Border>
        <Border 
         DockPanel.Dock="Top" 
         BorderBrush="#FF734444" 
         BorderThickness="1,0,1,1">

            <Grid>

                <!--<Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>-->


                <!--Settings Title-->

                <Grid Height="20" Margin="0 0 0 2">


                    <!--Back button-->

                    <Button Style="{StaticResource IconGrowButton}"
                    Height="40"
                    Content="{StaticResource FontAwesomeArrowLeftIcon}"
                    FontFamily="{StaticResource FontAwesome}"
                    Foreground="{StaticResource ForegroundDarkBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}" IsCancel="True"
                    />


                    <!--Settings header-->

                    <TextBlock FontSize="{StaticResource FontSizeLarge}"

                       Foreground="{StaticResource ForegroundVeryDarkBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                
             <!--Tree icon--> 
            
                <Run FontFamily="{StaticResource FontAwesome}"
                     Text="{StaticResource FontAwesomeProjectIcon}"                     
                     Foreground="{StaticResource WordOrangeBrush}" />
                
             <!--Settings text--> 
            
                <Run Text="{Binding ControlTitle}"
                     Foreground="{DynamicResource WordDarkBlueBrush}"
                     FontFamily="{DynamicResource LatoBold}" Background="{DynamicResource BackgroundVeryLightBrush}" />
                    </TextBlock>


                    <!--FAMILY TREE-->

                </Grid>
            </Grid>
        </Border>

        <DataGrid x:Name="BulkRecon" Grid.Row="3"  ItemsSource="{Binding BulkReconDetail}" 
                  HeadersVisibility="All" RenderTransformOrigin="0.5,0.5"                    
                    AutoGenerateColumns="False" AlternatingRowBackground="Aqua"
                    SelectionMode="Extended" SelectionUnit="FullRow" 
                  
                  
                  >
            <!--<DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight"  Value="ExtraBold" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.ColumnHeaderStyle>-->

            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <EventSetter Event ="MouseDoubleClick"  Handler="DataGridRow_MouseDoubleClick"/>
                    <EventSetter Event ="KeyDown"  Handler="DataGridRow_KeyDown"/>                    
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!--<DataGridTextColumn Header ="Bulk Meter" FontWeight="Bold"
                                    Binding="{Binding ShortName}"/>-->

                

                <DataGridTextColumn Header ="Meter Name" 
                                    Binding="{Binding  ShortName}" />

                <DataGridTemplateColumn Header="TimeStart">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=TimeStart,StringFormat=dd/MM/yyyy HH:mm}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <DataGridTextColumn Header ="Volume" 
                                    Binding="{Binding  Volume}" />
                <DataGridTextColumn Header ="Start Reading"
                                    Binding="{Binding MeterReadingCalc}"/>
                <DataGridTextColumn Header ="ReadingPriorStart"
                                    Binding="{Binding ReadingTimePrior}"/>
                <DataGridTextColumn Header ="ReadingAfterStart"
                                    Binding="{Binding ReadingTimeNext}"/>
                <DataGridTextColumn Header ="ReadingAfterStart"
                                    Binding="{Binding  ReadingNext}"/>
                <DataGridTextColumn Header ="TimeEnd"
                                    Binding="{Binding TimeEnd}"/>
            </DataGrid.Columns>


        </DataGrid>

    </DockPanel>
</UserControl>

