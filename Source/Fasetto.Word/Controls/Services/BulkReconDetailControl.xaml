<UserControl x:Class="Fasetto.Word.BulkReconDetailControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Fasetto.Word" xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms" xmlns:sys="clr-namespace:System;assembly=mscorlib" d:DataContext="{d:DesignInstance Type=local:BulkReconViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <sys:String x:Key="colName">dynamic string...</sys:String>
        <Style x:Key="ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" >
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Label Foreground="Blue" FontWeight="ExtraBlack" Background="AntiqueWhite" FontFamily="Lato Black" Content="{TemplateBinding Content}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment ="Center"  VerticalAlignment="Center"  />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--<sys:String x:Key="colCell">dynamic string...</sys:String>
        <Style x:Key="ColumnCellStyle" TargetType="{x:Type}" >
            <Setter Property="CellStyle">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridTextColumn">
                        <Label Foreground="black" FontWeight="UltraBold" Background="AntiqueWhite" FontFamily="Arial" Content="{TemplateBinding Content}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment ="Center"  VerticalAlignment="Center"  />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>-->
    </UserControl.Resources>

    <DockPanel>
        <!-- SEARCH AREA -->
        <Border 
         DockPanel.Dock="Bottom" 
         BorderBrush="#FFE22626" 
         BorderThickness="2,0,2,2">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#11A49090" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <!--<StackPanel 
                HorizontalAlignment="Stretch" 
                Margin="0,0,10,0" 
                Orientation="Horizontal"
                >
                <TextBox 
                      x:Name="searchTextBox"
                      KeyDown="SearchTextBox_KeyDown"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      Width="200" Height="43" FontSize="18" TextWrapping="Wrap" RenderTransformOrigin="0.1,0.616" AutomationProperties.HelpText="Begin entering name...."
                    >
                    <TextBox.InputBindings>
                        --><!--Clear text on Esc--><!--
                        <KeyBinding Command="{Binding ClearSearchCommand}" Key="Esc" />
                        --><!--Search on enter--><!--
                        <KeyBinding Command="{Binding SearchCommand}" Key="Return" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Style="{StaticResource IconGrowButton}" 
                        Content="{StaticResource FontAwesomeSearchIcon}"
                        Command="{Binding SearchCommand}"
                        Padding="4" Background="{DynamicResource WordOrangeBrush}" Height="43" Width="88" RenderTransformOrigin="1.221,0.593" AutomationProperties.HelpText="Search for items in the hierarchy" 
                      >
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource ForegroundLight}"/>
                    </Button.Foreground>
                    --><!--<Button.ToolTip>
                        <ToolTip Placement="Mouse"

                             Opened="ToolTip_Opened"

                             Closed="ToolTip_Closed">Login with the entered credentials</ToolTip>
                    </Button.ToolTip>--><!--
                </Button>
            </StackPanel>-->
        </Border>
        <Border 
         DockPanel.Dock="Top" 
         BorderBrush="#FF734444" 
         BorderThickness="1,0,1,1">

            <Grid>



                <!--Settings Title-->

                <Grid Height="20" Margin="0 0 0 2">


                    <!--Back button-->

                    <Button Style="{StaticResource IconGrowButton}"
                    Height="40"
                    Content="{StaticResource FontAwesomeArrowLeftIcon}"
                    FontFamily="{StaticResource FontAwesome}"
                    Foreground="{StaticResource ForegroundDarkBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}" IsCancel="True"
                    />


                    <!--Settings header-->

                    <TextBlock FontSize="{StaticResource FontSizeLarge}"

                       Foreground="{StaticResource ForegroundVeryDarkBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                
             <!--Tree icon--> 
            
                <Run FontFamily="{StaticResource FontAwesome}"
                     Text="{StaticResource FontAwesomeProjectIcon}"                     
                     Foreground="{StaticResource WordOrangeBrush}" />
                
             <!--Settings text--> 
            
                <Run Text="{Binding ControlTitle}"
                     Foreground="{DynamicResource WordDarkBlueBrush}"
                     FontFamily="{DynamicResource LatoBold}" Background="{DynamicResource BackgroundVeryLightBrush}" />
                    </TextBlock>


                    <!--FAMILY TREE-->

                </Grid>
            </Grid>
        </Border>



        <DataGrid x:Name="BulkReconDetail" Grid.Row="3"  ItemsSource="{Binding BulkReconDetail}" 
                  HeadersVisibility="All" RenderTransformOrigin="0.5,0.5"                    
                    AutoGenerateColumns="False" AlternatingRowBackground="Aqua"
                    SelectionMode="Single" SelectionUnit="FullRow"                                 
                  >

            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <EventSetter Event ="MouseDoubleClick"  Handler="DataGridRow_MouseDoubleClick"/>
                    <EventSetter Event ="KeyDown"  Handler="DataGridRow_KeyDown"/>
                    <EventSetter Event ="PreviewMouseRightButtonDown"  Handler="DataGridRow_MouseRightClick"/>
                </Style>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!--<DataGridTextColumn Header ="Bulk Meter" FontWeight="Bold"
                                    Binding="{Binding ShortName}"/>-->


                <DataGridTextColumn Header ="Meter Name" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding  ShortName}" 
                                    />


                <DataGridTemplateColumn Header="TimeStart" HeaderStyle="{StaticResource ColumnHeaderStyle}" >

                        
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=TimeStart,StringFormat=dd/MM/yyyy HH:mm}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="TimeEnd" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=TimeEnd,StringFormat=dd/MM/yyyy HH:mm}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Volume" HeaderStyle="{StaticResource ColumnHeaderStyle}" SortMemberPath="Volume">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Volume}" Foreground="Crimson" FontSize="12" FontWeight="UltraBold" FontFamily="arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header ="Volume" HeaderStyle="{StaticResource ColumnHeaderStyle}"   SortDirection="Descending" 
                                    Binding="{Binding  Volume}" />-->
                <DataGridTextColumn Header ="Start Reading" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding MeterReadingCalc}" />
                <DataGridTemplateColumn Header="ReadingTimePriorStart" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=ReadingTimePrior,StringFormat=dd/MM/yyyy HH:mm}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header ="ReadingPriorStart"   HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                     Binding="{Binding  ReadingPrior}"/>
                <DataGridTemplateColumn Header="ReadingTimeAfterStart" SortMemberPath=" ReadingTimeNext" HeaderStyle="{StaticResource ColumnHeaderStyle}" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path= ReadingTimeNext,StringFormat=dd/MM/yyyy HH:mm}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header ="ReadingTimeAfterStart" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding ReadingTimeNext}" />-->
                <DataGridTextColumn Header ="ReadingAfterStart" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding  ReadingNext}"/>

                <!--<DataGridTextColumn Header ="TimeEnd" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding TimeEnd}"/>-->
                <DataGridTextColumn Header ="EndReading" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding MeterReadingCalcE}" />
                <DataGridTemplateColumn Header="ReadingTimeBeforeEnd" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=ReadingTimePriorE,StringFormat=dd/MM/yyyy HH:mm}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header ="ReadingTimeAfterEnd" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding ReadingTimePriorE}"/>-->
                <DataGridTextColumn Header ="ReadingPriorE" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding  ReadingPriorE}"/>
                <DataGridTemplateColumn Header="ReadingTimeAfterEnd" HeaderStyle="{StaticResource ColumnHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=ReadingTimeNextE ,StringFormat=dd/MM/yyyy HH:mm}"  FontSize="12" FontWeight="Normal" FontFamily="arial" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header ="ReadingTimeAfterEnd" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding ReadingTimeNextE }"/>-->
                <DataGridTextColumn Header ="ReadingAfterEnd" HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                    Binding="{Binding ReadingNextE}"/>              
            </DataGrid.Columns>


        </DataGrid>

    </DockPanel>
</UserControl>

